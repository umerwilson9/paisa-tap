<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no">
<title>Alien Shooter</title>
<script src="https://telegram.org/js/telegram-web-app.js"></script>
<!-- MONETAG: yahan apni zone ka script tag paste karein. Jab tak paste nahi hota, DEMO ad (3 sec) chalega. -->

<style>
html,body{margin:0;height:100%;background:#1b1034;overflow:hidden;touch-action:none;user-select:none;-webkit-user-select:none;font-family:ui-rounded,"Segoe UI",system-ui,sans-serif;color:#fff7e6}
canvas{display:block;width:100%;height:100%}
button{font:inherit;font-weight:800;border:0;border-radius:14px;padding:14px 22px;color:#fff;cursor:pointer;background:#ff6b57}
button.alt{background:#4a2a72}
button:disabled{opacity:.5}
#power{position:fixed;top:calc(env(safe-area-inset-top,0px) + 46px);left:50%;transform:translateX(-50%);padding:8px 14px;font-size:14px}
#over{position:fixed;inset:0;display:none;flex-direction:column;align-items:center;justify-content:center;gap:12px;background:rgba(20,8,40,.9);text-align:center;padding:20px}
#over h1{margin:0;font-size:34px}
#over p{margin:0;color:#c9b5e0;font-size:18px}
#toast{position:fixed;left:50%;top:90px;transform:translateX(-50%);background:#fff7e6;color:#2a1740;padding:8px 14px;border-radius:12px;font-weight:800;opacity:0;transition:opacity .25s;pointer-events:none}
#toast.on{opacity:1}
</style>
</head>
<body>
<canvas id="c"></canvas>
<button id="power">&#127916; Ad dekho: 3x goli (20 sec)</button>
<div id="over">
  <h1>Game Over</h1>
  <p id="res"></p>
  <button id="revive">&#127916; Ad dekho: dobara zindagi</button>
  <button id="again" class="alt">Dobara khelein</button>
</div>
<div id="toast"></div>

<script>
const AD_FN = "";   // Monetag ka function naam, jaise "show_123456" (data-sdk wali value)

try{Telegram.WebApp.ready();Telegram.WebApp.expand();}catch(e){}
const $=id=>document.getElementById(id), cv=$("c"), cx=cv.getContext("2d");
let W,H;
function fit(){const d=devicePixelRatio||1;W=innerWidth;H=innerHeight;cv.width=W*d;cv.height=H*d;cx.setTransform(d,0,0,d,0,0);}
addEventListener("resize",fit);fit();

let best=0;try{best=+localStorage.getItem("best")||0}catch(e){}
let px=W/2,lives,score,bullets,enemies,fireT,spawnT,triple,state="over",revived;
function toast(t){const el=$("toast");el.textContent=t;el.classList.add("on");setTimeout(()=>el.classList.remove("on"),1800);}

function start(){px=W/2;lives=3;score=0;bullets=[];enemies=[];fireT=0;spawnT=0;triple=0;revived=false;state="play";$("over").style.display="none";}
function end(){
  state="over";
  if(score>best){best=score;try{localStorage.setItem("best",best)}catch(e){}}
  $("res").textContent="Score: "+score+"   |   Best: "+best;
  $("revive").style.display=revived?"none":"block";
  $("over").style.display="flex";
}

// ---- input: ungli ya mouse se left/right ----
function move(e){px=Math.max(24,Math.min(W-24,e.clientX));}
addEventListener("pointerdown",move);addEventListener("pointermove",move);

// ---- ads ----
function showAd(){
  if(AD_FN&&typeof window[AD_FN]==="function")return window[AD_FN]();
  return new Promise(r=>{toast("DEMO ad: 3 sec");setTimeout(r,3000);});
}
$("revive").onclick=()=>{
  $("revive").disabled=true;
  showAd().then(()=>{revived=true;lives=3;enemies=[];state="play";$("over").style.display="none";})
   .catch(()=>toast("Ad nahi chala")).finally(()=>$("revive").disabled=false);
};
$("power").onclick=()=>{
  if(state!=="play"||triple>0)return;
  $("power").disabled=true;
  showAd().then(()=>{triple=20;toast("3x goli shuru!");})
   .catch(()=>toast("Ad nahi chala")).finally(()=>$("power").disabled=false);
};
$("again").onclick=start;

// ---- game logic ----
function update(dt){
  fireT-=dt;
  if(fireT<=0){fireT=.22;const y=H-120;bullets.push({x:px,y,dx:0});
    if(triple>0){bullets.push({x:px-12,y,dx:-70});bullets.push({x:px+12,y,dx:70});}}
  triple=Math.max(0,triple-dt);
  spawnT-=dt;
  if(spawnT<=0){
    spawnT=Math.max(.35,1.1-score*.012);
    const big=Math.random()<.2;
    enemies.push({x:30+Math.random()*(W-60),y:-30,hp:big?3:1,big,
      v:(70+Math.min(score*1.5,130))*(big?.7:1)+Math.random()*30});
  }
  for(const b of bullets){b.y-=540*dt;b.x+=b.dx*dt;}
  for(const e of enemies)e.y+=e.v*dt;
  for(const b of bullets)for(const e of enemies){
    const r=e.big?32:24;
    if(!b.dead&&!e.dead&&Math.abs(b.x-e.x)<r&&Math.abs(b.y-e.y)<r){b.dead=1;e.hp--;if(e.hp<=0){e.dead=1;score+=e.big?3:1;}}
  }
  for(const e of enemies)if(!e.dead&&e.y>H-100){e.dead=1;lives--;}
  bullets=bullets.filter(b=>!b.dead&&b.y>-20);
  enemies=enemies.filter(e=>!e.dead);
  if(lives<=0)end();
}

function draw(){
  const g=cx.createLinearGradient(0,0,0,H);g.addColorStop(0,"#1b1034");g.addColorStop(1,"#3b1d5e");
  cx.fillStyle=g;cx.fillRect(0,0,W,H);
  cx.textAlign="center";cx.textBaseline="middle";
  for(const e of enemies){cx.font=(e.big?52:38)+"px serif";cx.fillText(e.big?"\u{1F479}":"\u{1F47E}",e.x,e.y);}
  cx.fillStyle="#ffd34d";
  for(const b of bullets){cx.beginPath();cx.arc(b.x,b.y,5,0,7);cx.fill();}
  cx.font="46px serif";cx.fillText("\u{1F920}",px,H-70);
  cx.font="30px serif";cx.fillText("\u{1F52B}",px+30,H-62);
  cx.fillStyle="#fff7e6";cx.font="800 22px ui-rounded,system-ui,sans-serif";
  cx.textAlign="left";cx.fillText("Score "+score,14,28+(parseFloat(getComputedStyle(document.documentElement).getPropertyValue("--sat"))||0));
  cx.textAlign="right";cx.fillText("\u2764\uFE0F".repeat(Math.max(0,lives)),W-14,28);
  if(triple>0){cx.textAlign="center";cx.fillStyle="#4fd1a5";cx.font="800 16px system-ui";cx.fillText("3x goli: "+Math.ceil(triple)+"s",W/2,H-20);}
}

let last=performance.now();
function loop(n){const dt=Math.min(.05,(n-last)/1000);last=n;if(state==="play")update(dt);draw();requestAnimationFrame(loop);}
start();requestAnimationFrame(loop);
</script>
</body>
</html>
